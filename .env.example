# Copy this file to .env for local use (never commit .env).

# Server-side key for the Geocoding API (local use only). Restrict it to "Geocoding API".
GOOGLE_MAPS_API_KEY=

# Browser key for the Maps JavaScript API, restricted by HTTP referrer.
# Optional locally (falls back to the key above); required when hosted.
GOOGLE_MAPS_BROWSER_KEY=

# Optional: a Map ID (Google Cloud Console -> Maps Platform -> Map Management) turns on
# Google's newer vector map renderer, which is noticeably smoother to zoom/pan than the
# default raster tiles. Leave blank to use the old renderer.
GOOGLE_MAPS_MAP_ID=

# Set to 0 on a hosted copy that uses geocode_seed.json.
GEOCODE_ON_STARTUP=1

# Optional demo login created at startup.
DEMO_EMAIL=
DEMO_PASSWORD=

# Password-reset emails (optional; leave SMTP_HOST empty to print links in the terminal).
APP_BASE_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
